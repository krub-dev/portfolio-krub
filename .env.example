# Copy this to .env.local and fill it in. Every `.env*` file is gitignored; only
# this template is tracked.
#
# The four server values are deliberately not VITE_-prefixed: Vite inlines any
# VITE_ variable into the client bundle, so they must stay server-side. The dev
# endpoint in vite.config.js and the Vercel function both read them from the
# process. Only VITE_TURNSTILE_SITE_KEY is public.
#
# In production these are set in the host's environment (Vercel), not in a file.

RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
TURNSTILE_SECRET_KEY=

VITE_TURNSTILE_SITE_KEY=
